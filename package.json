{
  "name": "papertrail",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "check": "node --check server.js && node --check public/app.js && node --check cloudflare/worker.js && node --check cloudflare/research.js && node --check public/research.js",
    "build": "node scripts/prepare-assets.js",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
